# AgentShield Configuration Environment Variables

# Moss Real-Time Semantic Search Runtime
# Obtain from https://moss.dev
MOSS_PROJECT_ID=your_moss_project_id
MOSS_API_KEY=your_moss_api_key_or_project_key
MOSS_ENDPOINT=https://api.moss.dev

# Agent LLM Provider (Optional fallback for simulated agent LLM reasoning)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# AgentShield Server Port & Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security Engine Configuration
AGENTSHIELD_FAIL_SAFE_MODE=true
AGENTSHIELD_INJECTION_THRESHOLD=75
AGENTSHIELD_EXFILTRATION_THRESHOLD=70
AGENTSHIELD_MIN_RELIABILITY_PASS=70
AGENTSHIELD_RATE_LIMIT_RPM=120
